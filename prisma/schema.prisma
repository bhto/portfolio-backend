generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "sqlite"
}

model Visitor {
    id             String   @id @default(cuid())
    clientId       String
    country        String?
    city           String?
    browser        String?
    browserVersion String?
    os             String?
    osVersion      String?
    device         String?
    createdAt      DateTime @default(now())
}
